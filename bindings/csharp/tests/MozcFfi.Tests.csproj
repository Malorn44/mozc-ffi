<Project Sdk="Microsoft.NET.Sdk">

  <!-- Run from the repo root with "dotnet run" and the project bindings/csharp/tests: the checks in Program.cs against build/'s native library. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MozcFfi.csproj" />
    <None Include="../../../build/libmozc_ffi.so" Condition="Exists('../../../build/libmozc_ffi.so')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../build/mozc_ffi.dll" Condition="Exists('../../../build/mozc_ffi.dll')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../tests/chat.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

# C# style for the bindings and their tests, checked by `dotnet format --verify-no-changes`.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,xml}]
indent_style = space
indent_size = 2
